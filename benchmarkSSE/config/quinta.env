#!/usr/bin/env bash

QUINTA_SSH_PREFIX=quinta-
QUINTA_REMOTE_ROOT=/root/multiclientSSE-quinta

QUINTA_NODES=(s1 s2 s3 s4 s5 s6 s7 s8 s9 s12 s16)
QUINTA_NODE_IPS=(
  192.168.2.21
  192.168.2.22
  192.168.2.23
  192.168.2.24
  192.168.2.25
  192.168.2.26
  192.168.2.27
  192.168.2.28
  192.168.2.29
  192.168.2.32
  192.168.2.36
)

QUINTA_BASE_CLIENT_PORT=11000
QUINTA_ORAM_BASE_CLIENT_PORT=12000
QUINTA_PORT_STEP=10
QUINTA_TTP_IP=192.168.2.21
QUINTA_TTP_PORT=11100
QUINTA_ORAM_TTP_PORT=12100

QUINTA_REPLICA_JAVA_OPTS="-Xms10g -Xmx10g -XX:+UseG1GC -XX:+AlwaysPreTouch -XX:+ExitOnOutOfMemoryError"
QUINTA_ORAM_REPLICA_JAVA_OPTS="-Xms10g -Xmx10g -XX:+UseG1GC -XX:+AlwaysPreTouch -XX:+ExitOnOutOfMemoryError"
QUINTA_CLIENT_JAVA_OPTS="-Xms10g -Xmx10g -XX:+UseG1GC -XX:+AlwaysPreTouch -XX:+ExitOnOutOfMemoryError"
QUINTA_READY_TIMEOUT_SECONDS=240
QUINTA_REQUIRED_JAVA_MAJOR=11

QUINTA_SSH_CONNECT_TIMEOUT_SECONDS=30
QUINTA_SSH_SERVER_ALIVE_INTERVAL_SECONDS=5
QUINTA_SSH_SERVER_ALIVE_COUNT_MAX=2
