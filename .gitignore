# Ignore Gradle project-specific cache directory
.gradle

# Ignore Gradle build output directory
build

# Ignore VS Code settings directory
.vscode

# Ignore Python bytecode/cache files
__pycache__/
*.pyc

# Ignore Jenv settings directory
.java-version

# Ignore downloaded datasets and processed datasets
datasets/raw/
datasets/processed/

# Ignore generated benchmark artifacts, including per-run result/log/plot folders.
benchmarkSSE/datasets/
benchmarkSSE/results/
benchmarkSSE/plots/

# Ignore bin directory for compiled classes
bin

# Ignore local Quinta hosts snippet.
multiclientSSE-hosts-nodes

# Ignore macOS Finder metadata
.DS_Store

# Ignore local Gradle deployment properties
/gradle.properties

# Ignore local notes
NOTES.md
